// # oocolor package
//
// Logline: Stock catalog package for oocolor.
//
// Setup: Folder shape is manifest plus payload. Do not import oocolor.oo from this file.
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oocolor.oo.
//   2. oocolor.oo — payload. Academy headers required.
//   3. Rebuild the parent catalog with: opm bot .

//   4. Keep the manifest sha256 in lockstep with the payload.
//   5. The package page stays inside the catalog file law.

pub fn cat_oocolor_pkg() -> String {
    return "oocolor";
}
