// # oocat package
//
// Logline: Stock catalog package for oocat.
//
// Setup: Folder shape is manifest plus payload. Do not import oocat.oo from this file.
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oocat.oo.
//   2. oocat.oo — payload. Academy headers required.
//   3. Rebuild the parent catalog with: opm bot .

//   4. Keep the manifest sha256 in lockstep with the payload.
//   5. The package page stays inside the catalog file law.

pub fn cat_oocat_pkg() -> String {
    return "oocat";
}
