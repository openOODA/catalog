// # oogrep Main - Argv Router And Entry Point
//
// Logline: Parses startup flags, resolves the search policy, and dispatches to the CLI or MCP surface.
//
// Setup: Wires FsReadCap only. oogrep never spawns a process, writes a file, or opens a socket.
//
// Beats:
//   1. Pre-pass --help, --version, and --mcp without touching the filesystem.
//   2. Resolve the search policy from flags and positional arguments.
//   3. Run the search and map its outcome onto the grep convention exit codes.

import "parse_decimal.oo";
import "search_opts.oo";
import "search.oo";
import "render/render_errors.oo";
import "render/render_theme.oo";
import "mcp/serve.oo";
import "flags.oo";

fn has_flag(args: List[String], short: String, long: String) -> Bool {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    let use_short: Bool = chars_len(short) > 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == long || (use_short && a == short) { return true; }
        i = i + 1;
    }
    return false;
}

fn parse_args(args: List[String], theme: String) -> Result[SearchOpts, String] {
    let mut o: SearchOpts = SearchOpts {
        pattern: "", roots: list_new(), glob: "", ignore_case: false, invert: false,
        count_mode: false, files_only: false, show_lines: false, color: true,
        max_depth: default_depth(), respect_ignore: true, budget: default_budget(), quiet: false,
        max_count: 0, whole_word: false, ctx_before: 0, ctx_after: 0,
        show_column: false, show_filename: true, filename_auto: true,
        json_mode: false, theme: theme
    };
    let mut positionals: Int = 0;
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        let sw: ArgStep = apply_switch(o, a, i, positionals);
        if sw.handled {
            o = sw.opts;
            i = sw.index;
            positionals = sw.positionals;
        } else {
            let val: ArgStep = apply_valued(o, args, a, i, positionals);
            if val.handled {
                if chars_len(val.err) > 0 { return Err(val.err); }
                o = val.opts;
                i = val.index;
                positionals = val.positionals;
            } else {
                let rest: ArgStep = apply_rest(o, args, a, i, positionals, n);
                if chars_len(rest.err) > 0 { return Err(rest.err); }
                o = rest.opts;
                i = rest.index;
                positionals = rest.positionals;
            }
        }
    }
    if positionals == 0 || chars_len(o.pattern) == 0 {
        return Err("missing required <pattern>");
    }
    if list_len(o.roots) == 0 { o.roots = list_push(o.roots, "."); }
    return Ok(o);
}

// ProcessCap is declared here for parity with the standalone oogrep entrypoint
// even though this payload never spawns a process.
pub fn main(fs: &FsReadCap, proc_cap: &ProcessCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    if has_flag(args, "", "--mcp") {
        let mcp_rc: Int = mcp_serve(fs);
        return Ok(mcp_rc);
    }

    let theme: String = resolve_grep_theme(fs, env);
    let parsed: Result[SearchOpts, String] = parse_args(args, theme);
    if parsed.is_err() {
        let m: String = match parsed { Ok(_) => "", Err(e) => e };
        if m == "__help" || m == "__version" { return Ok(0); }
        print(render_usage_error(m));
        return Ok(2);
    }

    let o: SearchOpts = match parsed { Ok(v) => v, Err(_) => opts_defaults() };

    let out: SearchOutcome = run_search(fs, o);
    if !out.ok {
        print(render_error(out.err));
        return Ok(2);
    }
    if !o.quiet {
        print(out.text);
    }
    if out.matched_files > 0 { return Ok(0); }
    return Ok(1);
}
