// # OpenOODA public catalog
//
// Logline: The list of packages opm search and opm add can install.
//
// Setup: This repo is a vendor tree. catalog is name|version|caps|deps|sha.
//        Each child folder is one package (manifest + payload).
//        Host: https://catalog.openooda.org
//        Not a registry service. No accounts. No daemon.
//        Do not import package payloads from this file.
//
// Beats:
//   1. catalog — the search index. index is a copy. index.minisig signs it.
//   2. hello — print hello.
//   3. echo — print echo.
//   3b. caps — print the 20 language capability tokens.
//   3c. sqlite — SQLite boundary adapter demo (pure header decode).
//   4. .github/workflows/ci.yml is the build, test, verify, release
//      entry point (gh-owned; no scripts/ runners).
//   5. qa/ — catalog_proof.oo.
//   6. docs/ — file format, host, adding a package.
//   7. Rebuild the index with: opm bot .

import "hello/ANCHOR.oo";
import "echo/ANCHOR.oo";
import "caps/ANCHOR.oo";
import "sqlite/ANCHOR.oo";
import "qa/ANCHOR.oo";
import "docs/ANCHOR.oo";
