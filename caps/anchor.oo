// # Caps package
//
// Logline: Stock catalog package that prints the 20 language capability tokens.
//
// Setup: Folder shape is manifest plus payload. Do not import caps.oo from this file.
//
// Beats:
//   1. manifest — name, version, caps, sha256 of caps.oo.
//   2. caps.oo — payload. Academy headers required.
//   3. Rebuild the parent catalog with: opm bot .

//   4. Keep the manifest sha256 in lockstep with the payload.
//   5. The package page stays inside the catalog file law.

pub fn cat_caps_pkg() -> String {
    return "caps";
}
