// # Caps
//
// Logline: Print all 32 canonical openOODA explicit capabilities (19 software/OS + 13 hardware).
//
// Setup: No extra caps. Safe to launch. Lattice SSoT is oodar cap_table.json (bits 0..31).
//
// Beats:
//   1. Print each of the 32 explicit capabilities in the 64-bit capability register architecture.

pub fn main(fs_r: &FsReadCap) {
    println("FsReadCap");
    println("FsWriteCap");
    println("FsCap");
    println("NetCap");
    println("TcpCap");
    println("UdpCap");
    println("BindCap");
    println("SysCap");
    println("ProcessCap");
    println("EnvCap");
    println("TimeCap");
    println("RandCap");
    println("AllocCap");
    println("ArenaCap");
    println("ThreadCap");
    println("GpuCap");
    println("FfiCap");
    println("SignCap");
    println("MetricsCap");
    println("CompilerReadCap");
    println("AudioCap");
    println("CameraCap");
    println("UsbCap");
    println("HidCap");
    println("WindowCap");
    println("FrameCap");
    println("MmioCap");
    println("DmaCap");
    println("IrqCap");
    println("PciCap");
    println("BlockCap");
    println("TpmCap");
}

