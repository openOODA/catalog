// # oogrep Flag Steps
//
// Logline: Turn one argv token into a search-option step.
//
// Setup: Pure updates of SearchOpts. Help and version print, then return a sentinel error.
//
// Beats:
//   1. Boolean flags flip one field and advance one token.
//   2. Valued flags read the next token or return the missing-value error.
//   3. The remainder handles end-of-flags, help, version, and positionals.

import "parse_decimal.oo";
import "search_opts.oo";
import "render/render_theme.oo";

type ArgStep = struct {
    opts: SearchOpts,
    index: Int,
    positionals: Int,
    handled: Bool,
    err: String,
};

fn arg_value(args: List[String], idx: Int) -> String {
    let n: Int = list_len(args);
    if idx + 1 >= n { return ""; }
    return list_get(args, idx + 1);
}

fn flag_value(args: List[String], i: Int, flag: String) -> Result[String, String] {
    let v: String = arg_value(args, i);
    if chars_len(v) == 0 { return Err("missing value for " + flag); }
    return Ok(v);
}

pub fn apply_switch(o0: SearchOpts, a: String, i: Int, pos: Int) -> ArgStep {
    let mut o: SearchOpts = o0;
    if a == "-i" || a == "--ignore-case" {
        o.ignore_case = true;
        return ArgStep { opts: o, index: i + 1, positionals: pos, handled: true, err: "" };
    }
    if a == "-v" || a == "--invert-match" {
        o.invert = true;
        return ArgStep { opts: o, index: i + 1, positionals: pos, handled: true, err: "" };
    }
    if a == "-c" || a == "--count" {
        o.count_mode = true;
        return ArgStep { opts: o, index: i + 1, positionals: pos, handled: true, err: "" };
    }
    if a == "-l" || a == "--files-with-matches" {
        o.files_only = true;
        return ArgStep { opts: o, index: i + 1, positionals: pos, handled: true, err: "" };
    }
    if a == "-n" || a == "--line-number" {
        o.show_lines = true;
        return ArgStep { opts: o, index: i + 1, positionals: pos, handled: true, err: "" };
    }
    if a == "--no-line-number" {
        o.show_lines = false;
        return ArgStep { opts: o, index: i + 1, positionals: pos, handled: true, err: "" };
    }
    if a == "--no-color" {
        o.color = false;
        return ArgStep { opts: o, index: i + 1, positionals: pos, handled: true, err: "" };
    }
    if a == "--column" {
        o.show_column = true;
        return ArgStep { opts: o, index: i + 1, positionals: pos, handled: true, err: "" };
    }
    if a == "--json" {
        o.json_mode = true;
        return ArgStep { opts: o, index: i + 1, positionals: pos, handled: true, err: "" };
    }
    if a == "--no-filename" {
        o.show_filename = false;
        o.filename_auto = false;
        return ArgStep { opts: o, index: i + 1, positionals: pos, handled: true, err: "" };
    }
    if a == "-H" || a == "--with-filename" {
        o.show_filename = true;
        o.filename_auto = false;
        return ArgStep { opts: o, index: i + 1, positionals: pos, handled: true, err: "" };
    }
    if a == "--no-ignore" {
        o.respect_ignore = false;
        return ArgStep { opts: o, index: i + 1, positionals: pos, handled: true, err: "" };
    }
    if a == "-q" || a == "--quiet" || a == "--silent" {
        o.quiet = true;
        return ArgStep { opts: o, index: i + 1, positionals: pos, handled: true, err: "" };
    }
    if a == "-w" || a == "--word-regexp" {
        o.whole_word = true;
        return ArgStep { opts: o, index: i + 1, positionals: pos, handled: true, err: "" };
    }
    return ArgStep { opts: o, index: i, positionals: pos, handled: false, err: "" };
}

pub fn apply_valued(o0: SearchOpts, args: List[String], a: String, i: Int, pos: Int) -> ArgStep {
    let mut o: SearchOpts = o0;
    if a == "-m" || a == "--max-count" {
        let r: Result[String, String] = flag_value(args, i, "--max-count");
        let raw: String = match r { Ok(v) => v, Err(_) => "" };
        let err: String = match r { Ok(_) => "", Err(e) => e };
        o.max_count = parse_decimal(raw, 0);
        return ArgStep { opts: o, index: i + 2, positionals: pos, handled: true, err: err };
    }
    if a == "-A" || a == "--after-context" {
        let r: Result[String, String] = flag_value(args, i, "--after-context");
        let raw: String = match r { Ok(v) => v, Err(_) => "" };
        let err: String = match r { Ok(_) => "", Err(e) => e };
        o.ctx_after = parse_decimal(raw, 0);
        return ArgStep { opts: o, index: i + 2, positionals: pos, handled: true, err: err };
    }
    if a == "-B" || a == "--before-context" {
        let r: Result[String, String] = flag_value(args, i, "--before-context");
        let raw: String = match r { Ok(v) => v, Err(_) => "" };
        let err: String = match r { Ok(_) => "", Err(e) => e };
        o.ctx_before = parse_decimal(raw, 0);
        return ArgStep { opts: o, index: i + 2, positionals: pos, handled: true, err: err };
    }
    if a == "-C" || a == "--context" {
        let r: Result[String, String] = flag_value(args, i, "--context");
        let raw: String = match r { Ok(v) => v, Err(_) => "" };
        let err: String = match r { Ok(_) => "", Err(e) => e };
        o.ctx_before = parse_decimal(raw, 0);
        o.ctx_after = o.ctx_before;
        return ArgStep { opts: o, index: i + 2, positionals: pos, handled: true, err: err };
    }
    if a == "-g" || a == "--glob" {
        let r: Result[String, String] = flag_value(args, i, "--glob");
        let vg: String = match r { Ok(v) => v, Err(_) => "" };
        let err: String = match r { Ok(_) => "", Err(e) => e };
        if chars_len(o.glob) == 0 {
            o.glob = vg;
        } else {
            o.glob = o.glob + "," + vg;
        }
        return ArgStep { opts: o, index: i + 2, positionals: pos, handled: true, err: err };
    }
    if a == "-e" || a == "--regexp" {
        let r: Result[String, String] = flag_value(args, i, "-e");
        let err: String = match r { Ok(_) => "", Err(e) => e };
        o.pattern = match r { Ok(v) => v, Err(_) => "" };
        return ArgStep { opts: o, index: i + 2, positionals: 1, handled: true, err: err };
    }
    if a == "--max-depth" {
        let r: Result[String, String] = flag_value(args, i, "--max-depth");
        let raw: String = match r { Ok(v) => v, Err(_) => "" };
        let err: String = match r { Ok(_) => "", Err(e) => e };
        o.max_depth = parse_decimal(raw, default_depth());
        return ArgStep { opts: o, index: i + 2, positionals: pos, handled: true, err: err };
    }
    if a == "--max-matches" {
        let r: Result[String, String] = flag_value(args, i, "--max-matches");
        let raw: String = match r { Ok(v) => v, Err(_) => "" };
        let err: String = match r { Ok(_) => "", Err(e) => e };
        o.budget = parse_decimal(raw, default_budget());
        return ArgStep { opts: o, index: i + 2, positionals: pos, handled: true, err: err };
    }
    return ArgStep { opts: o, index: i, positionals: pos, handled: false, err: "" };
}

pub fn apply_rest(o0: SearchOpts, args: List[String], a: String, i: Int, pos: Int, n: Int) -> ArgStep {
    let mut o: SearchOpts = o0;
    if a == "--" {
        let mut j: Int = i + 1;
        let mut p: Int = pos;
        while j < n {
            let item: String = list_get(args, j);
            if p == 0 {
                o.pattern = item;
            } else {
                o.roots = list_push(o.roots, item);
            }
            p = p + 1;
            j = j + 1;
        }
        return ArgStep { opts: o, index: j, positionals: p, handled: true, err: "" };
    }
    if a == "-h" || a == "--help" {
        print(render_help());
        return ArgStep { opts: o, index: i, positionals: pos, handled: true, err: "__help" };
    }
    if a == "-V" || a == "--version" {
        print(render_version());
        return ArgStep { opts: o, index: i, positionals: pos, handled: true, err: "__version" };
    }
    if str_starts_with(a, "-") && chars_len(a) > 1 {
        let msg: String = "unknown flag: " + a;
        return ArgStep { opts: o, index: i, positionals: pos, handled: true, err: msg };
    }
    if pos == 0 {
        o.pattern = a;
    } else {
        o.roots = list_push(o.roots, a);
    }
    return ArgStep { opts: o, index: i + 1, positionals: pos + 1, handled: true, err: "" };
}
