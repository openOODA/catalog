// # oogrep Main - Argv Router And Entry Point
//
// Logline: Parses startup flags, resolves the search policy, and dispatches to the CLI or MCP surface.
//
// Setup: Wires FsReadCap only. oogrep never spawns a process, writes a file, or opens a socket.
//
// Beats:
//   1. Pre-pass --help, --version, and --mcp without touching the filesystem.
//   2. Resolve the search policy from flags and positional arguments.
//   3. Run the search and map its outcome onto the grep convention exit codes.

import "parse_decimal.oo";
import "search_opts.oo";
import "search.oo";
import "render/render_errors.oo";
import "render/render_theme.oo";
import "mcp/serve.oo";

fn has_flag(args: List[String], short: String, long: String) -> Bool {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    let use_short: Bool = chars_len(short) > 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == long || (use_short && a == short) { return true; }
        i = i + 1;
    }
    return false;
}

fn arg_value(args: List[String], idx: Int) -> String {
    let n: Int = list_len(args);
    if idx + 1 >= n { return ""; }
    return list_get(args, idx + 1);
}

fn flag_value(args: List[String], i: Int, flag: String) -> Result[String, String] {
    let v: String = arg_value(args, i);
    if chars_len(v) == 0 { return Err("missing value for " + flag); }
    return Ok(v);
}

fn parse_args(args: List[String], theme: String) -> Result[SearchOpts, String] {
    let mut o: SearchOpts = SearchOpts {
        pattern: "", roots: list_new(), glob: "", ignore_case: false, invert: false,
        count_mode: false, files_only: false, show_lines: false, color: true,
        max_depth: default_depth(), respect_ignore: true, budget: default_budget(), quiet: false,
        max_count: 0, whole_word: false, ctx_before: 0, ctx_after: 0,
        show_column: false, show_filename: true, filename_auto: true,
        json_mode: false, theme: theme
    };
    let mut positionals: Int = 0;

    let n: Int = list_len(args); let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == "-i" || a == "--ignore-case" { o.ignore_case = true; i = i + 1; }
        else if a == "-v" || a == "--invert-match" { o.invert = true; i = i + 1; }
        else if a == "-c" || a == "--count" { o.count_mode = true; i = i + 1; }
        else if a == "-l" || a == "--files-with-matches" { o.files_only = true; i = i + 1; }
        else if a == "-n" || a == "--line-number" { o.show_lines = true; i = i + 1; }
        else if a == "--no-line-number" { o.show_lines = false; i = i + 1; }
        else if a == "--no-color" { o.color = false; i = i + 1; }
        else if a == "--column" { o.show_column = true; i = i + 1; }
        else if a == "--json" { o.json_mode = true; i = i + 1; }
        else if a == "--no-filename" { o.show_filename = false; o.filename_auto = false; i = i + 1; }
        else if a == "-H" || a == "--with-filename" { o.show_filename = true; o.filename_auto = false; i = i + 1; }
        else if a == "--no-ignore" { o.respect_ignore = false; i = i + 1; }
        else if a == "-q" || a == "--quiet" || a == "--silent" { o.quiet = true; i = i + 1; }
        else if a == "-w" || a == "--word-regexp" { o.whole_word = true; i = i + 1; }
        else if a == "-m" || a == "--max-count" { let r: Result[String, String] = flag_value(args, i, "--max-count");
            if r.is_err() { return Err("missing value for --max-count"); } o.max_count = parse_decimal(match r { Ok(s) => s, Err(_) => "" }, 0); i = i + 2; }
        else if a == "-A" || a == "--after-context" { let r: Result[String, String] = flag_value(args, i, "--after-context");
            if r.is_err() { return Err("missing value for --after-context"); } o.ctx_after = parse_decimal(match r { Ok(s) => s, Err(_) => "" }, 0); i = i + 2; }
        else if a == "-B" || a == "--before-context" { let r: Result[String, String] = flag_value(args, i, "--before-context");
            if r.is_err() { return Err("missing value for --before-context"); } o.ctx_before = parse_decimal(match r { Ok(s) => s, Err(_) => "" }, 0); i = i + 2; }
        else if a == "-C" || a == "--context" { let r: Result[String, String] = flag_value(args, i, "--context");
            if r.is_err() { return Err("missing value for --context"); } o.ctx_before = parse_decimal(match r { Ok(s) => s, Err(_) => "" }, 0); o.ctx_after = o.ctx_before; i = i + 2; }
        else if a == "-g" || a == "--glob" { let r: Result[String, String] = flag_value(args, i, "--glob");
            if r.is_err() { return Err("missing value for --glob"); } let vg: String = match r { Ok(s) => s, Err(_) => "" };
            o.glob = if chars_len(o.glob) == 0 { vg } else { o.glob + "," + vg }; i = i + 2; }
        else if a == "-e" || a == "--regexp" { let r: Result[String, String] = flag_value(args, i, "-e");
            if r.is_err() { return Err("missing value for -e"); } o.pattern = match r { Ok(s) => s, Err(_) => "" }; positionals = 1; i = i + 2; }
        else if a == "--" { i = i + 1;
            while i < n { let pos: String = list_get(args, i);
                if positionals == 0 { o.pattern = pos; } else { o.roots = list_push(o.roots, pos); }
                positionals = positionals + 1; i = i + 1; } }
        else if a == "--max-depth" { let r: Result[String, String] = flag_value(args, i, "--max-depth");
            if r.is_err() { return Err("missing value for --max-depth"); } o.max_depth = parse_decimal(match r { Ok(s) => s, Err(_) => "" }, default_depth()); i = i + 2; }
        else if a == "--max-matches" { let r: Result[String, String] = flag_value(args, i, "--max-matches");
            if r.is_err() { return Err("missing value for --max-matches"); } o.budget = parse_decimal(match r { Ok(s) => s, Err(_) => "" }, default_budget()); i = i + 2; }
        else if a == "-h" || a == "--help" { print(render_help()); return Err("__help"); }
        else if a == "-V" || a == "--version" { print(render_version()); return Err("__version"); }
        else if str_starts_with(a, "-") && chars_len(a) > 1 { return Err("unknown flag: " + a); }
        else { if positionals == 0 { o.pattern = a; } else { o.roots = list_push(o.roots, a); } positionals = positionals + 1; i = i + 1; }
    }

    if positionals == 0 || chars_len(o.pattern) == 0 { return Err("missing required <pattern>"); }
    if list_len(o.roots) == 0 { o.roots = list_push(o.roots, "."); }

    return Ok(o);
}

// ProcessCap is declared here for parity with the standalone oogrep entrypoint
// even though this payload never spawns a process.
pub fn main(fs: &FsReadCap, proc_cap: &ProcessCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    if has_flag(args, "", "--mcp") {
        let mcp_rc: Int = mcp_serve(fs);
        return Ok(mcp_rc);
    }

    let theme: String = resolve_grep_theme(fs, env);
    let parsed: Result[SearchOpts, String] = parse_args(args, theme);
    if parsed.is_err() {
        let m: String = match parsed { Ok(_) => "", Err(e) => e };
        if m == "__help" || m == "__version" { return Ok(0); }
        print(render_usage_error(m));
        return Ok(2);
    }

    let o: SearchOpts = match parsed { Ok(v) => v, Err(_) => opts_defaults() };

    let out: SearchOutcome = run_search(fs, o);
    if !out.ok {
        print(render_error(out.err));
        return Ok(2);
    }
    if !o.quiet {
        print(out.text);
    }
    if out.matched_files > 0 { return Ok(0); }
    return Ok(1);
}
