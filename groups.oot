# groups.oot — @group profiles for the openOODA binary hub.
#
# File: catalog/groups.oot
#
# One group per line: `@name = pkg pkg pkg ...`. `@all` expands to every
# product package across the canonical 3 product organizations (@core, @system,
# @apps). `@games` is the game subset of @apps and `@desktop` / `@workstation`
# install the full OS + userland stack.
# install.sh and ooda-package expand these names against the release pool at
# https://github.com/openOODA/install/releases/latest/download/ — group
# membership selects binaries, not catalog folders. Layer directories
# (layers/core/, layers/system/, layers/apps/) hold the package manifests; this
# file is the install-time selection contract.

@core = ooda ooda-binary ooda-bridge ooda-build ooda-compiler ooda-engine ooda-format ooda-interface ooda-language ooda-package ooda-provenance ooda-runtime ooda-sign ooda-standard ooda-verify
@system = ooda-archive ooda-authority ooda-boot ooda-bus ooda-compositor ooda-connect ooda-container ooda-data ooda-database ooda-disk ooda-drivers ooda-files ooda-filesystem ooda-firewall ooda-hardware ooda-health ooda-inference ooda-kernel ooda-list ooda-machine ooda-modem ooda-network ooda-notepad ooda-panel ooda-portal ooda-read ooda-sandbox ooda-screensaver ooda-settings ooda-shell ooda-start ooda-terminal ooda-text ooda-theme ooda-vault ooda-version ooda-web
@apps = ooda-arcade ooda-browser ooda-calculator ooda-calendar ooda-camera ooda-chat ooda-clock ooda-commander ooda-emulator ooda-flasher ooda-media ooda-office ooda-passwords ooda-photos ooda-remote ooda-screenshot ooda-software ooda-strike ooda-studio ooda-voxel
@games = ooda-arcade ooda-commander ooda-emulator ooda-strike ooda-voxel
@desktop = @core @system @apps
@workstation = @core @system @apps
@all = @core @system @apps
