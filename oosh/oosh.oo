// # oosh Main - Argv Router and Interactive Shell Entry
//
// Logline: Parse startup flags, validate environment, and launch bounded shell, script, or Varlink daemon.
//
// Setup: Wire capability tokens per openOODA capability model. Handle flags, scripts, .ooshrc, and REPL.
//
// Beats:
//   1. Pre-pass --help, --version, and flags without side effects.
//   2. Support positional .oosh script execution and shebang env invocation of oosh with args.
//   3. Source ~/.ooshrc configuration into session environment and alias table.
//   4. Initialize prompt and dispatch to the OODA REPL engine with FfiCap.

import "oostd/fs/process/env.oo";
import "alias.oo";
import "prompt.oo";
import "version.oo";
import "engine.oo";
import "dispatch.oo";
import "flight/anchor.oo";
import "ipc/anchor.oo";
import "ui/anchor.oo";
import "ui/theme_io.oo";
import "startup.oo";
import "argv.oo";

type ScriptJob = struct {
    path: String,
    args: List[String],
    rec: FlightRecord,
    session: SessionState,
};

fn run_script_file(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap,
    env: &EnvCap, ffi: &FfiCap, job: ScriptJob) -> Int {
    let sr: Result[String, String] = read_file(fs_r, job.path);
    if sr.is_err() {
        println("ERR\toosh\tcannot read script: " + job.path);
        return 1;
    }
    let num_args: Int = list_len(job.args);
    let with_zero: EnvMap = env_map_set(job.session.env_map, "0", job.path);
    let mut em: EnvMap = env_map_set(with_zero, "#", num_args.to_string());
    let mut all_args_str: String = "";
    let mut ai: Int = 0;
    while ai < num_args {
        let arg_val: String = list_get(job.args, ai);
        em = env_map_set(em, (ai + 1).to_string(), arg_val);
        if all_args_str == "" {
            all_args_str = arg_val;
        } else {
            all_args_str = all_args_str + " " + arg_val;
        }
        ai = ai + 1;
    }
    em = env_map_set(env_map_set(em, "@", all_args_str), "*", all_args_str);
    let cur_sess: SessionState = SessionState {
        cwd: job.session.cwd, env_map: em, alias_map: job.session.alias_map,
        job_table: job.session.job_table, func_map: job.session.func_map
    };
    let body: String = match sr { Ok(s) => s, Err(_) => "" };
    let res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, body, job.rec, cur_sess);
    return res.exit_code;
}

fn source_rc(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, env: &EnvCap,
    ffi: &FfiCap, path: String, rec: FlightRecord, session: SessionState) -> SessionState {
    let r: Result[String, String] = read_file(fs_r, path);
    if r.is_ok() {
        let body: String = match r { Ok(s) => s, Err(_) => "" };
        let ran: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, body, rec, session);
        return ran.session;
    }
    return session;
}

fn source_profiles(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, env: &EnvCap,
    ffi: &FfiCap, rec: FlightRecord, session: SessionState, plan: LaunchPlan) -> SessionState {
    let mut out: SessionState = session;
    let is_login: Bool = is_login_invocation(fs_r, plan.is_login_flag);
    let home: String = match env_map_get(out.env_map, "HOME") { Ok(h) => h, Err(_) => "" };
    if is_login && !plan.no_profile {
        let profile_ok: Bool = (read_file(fs_r, "/etc/oosh/profile")).is_ok();
        if profile_ok {
            out = source_rc(fs_r, fs_w, sys, env, ffi, "/etc/oosh/profile", rec, out);
        }
        let user_profile: String = home + "/.oosh_profile";
        if home != "" && (read_file(fs_r, user_profile)).is_ok() {
            out = source_rc(fs_r, fs_w, sys, env, ffi, user_profile, rec, out);
        }
    }
    let want_rc: Bool = !plan.no_rc && home != "";
    if want_rc && (!plan.has_c_flag || plan.is_interactive_forced) {
        let rc_path: String = home + "/.ooshrc";
        out = source_rc(fs_r, fs_w, sys, env, ffi, rc_path, rec, out);
    }
    return out;
}

fn is_login_invocation(fs_r: &FsReadCap, is_login_flag: Bool) -> Bool {
    if is_login_flag { return true; }
    let r_cmd: Result[String, String] = read_file(fs_r, "/proc/self/cmdline");
    if r_cmd.is_ok() {
        let s: String = match r_cmd { Ok(b) => b, Err(_) => "" };
        let z: Int = str_index_of(s, bytes_to_str(bytes_push(bytes_new(), 0)));
        let a0: String = if z > 0 { str_slice(s, 0, z) } else { s };
        let parts: List[String] = str_split(a0, "/");
        let pn: Int = list_len(parts);
        let base: String = if pn > 0 { list_get(parts, pn - 1) } else { a0 };
        return str_starts_with(base, "-");
    }
    return false;
}

// The entry keeps the eight caps the body names. Shape law allows eight.
pub fn main(bind: &BindCap, fs_r: &FsReadCap, sys: &ProcessCap, env: &EnvCap,
    time: &TimeCap, fs_w: &FsWriteCap, ffi: &FfiCap, args: List[String]) -> Result[Int, String] {
    let pre: Result[String, String] = validate_argv(args);
    let kind: String = match pre { Ok(s) => s, Err(_) => "validated" };
    if kind == "showed-help" || kind == "showed-version" { return Ok(0); }
    let plan: LaunchPlan = parse_launch(args);
    let mut cwd: String = match env_get(env, "PWD") { Ok(s) => s, Err(_) => "" };
    if cwd == "" || cwd == "." {
        let esc: String = bytes_to_str(bytes_push(bytes_new(), 27));
        let pr_pwd: Result[String, String] = oo_tui_write(ffi, esc + "_pwd");
        let cw: String = match pr_pwd { Ok(s) => str_trim(s), Err(_) => "" };
        cwd = if cw != "" { cw } else { "." };
    }
    let rec: FlightRecord = flight_init();
    let boot: EnvMap = load_startup_environ(ffi, fs_r, env, cwd);
    let mut session: SessionState = SessionState {
        cwd: cwd, env_map: boot, alias_map: alias_map_new(),
        job_table: job_table_new(), func_map: func_map_new()
    };
    if plan.is_interactive_forced {
        session.env_map = env_map_set(session.env_map, "OOSH_INTERACTIVE", "1");
    }
    let cur_th: Result[String, String] = env_map_get(session.env_map, "OODA_THEME");
    let theme_now: String = match cur_th { Ok(s) => s, Err(_) => "" };
    if cur_th.is_err() || theme_now == "" {
        let theme: String = resolve_shell_theme(fs_r, env, cwd);
        session.env_map = env_map_set(session.env_map, "OODA_THEME", theme);
    }
    if plan.has_varlink_call {
        print(ipc_route(sys, cwd, rec, plan.varlink_payload));
        return Ok(0);
    }
    if plan.is_daemon { return Ok(ipc_run_daemon(sys, env, ffi, cwd, rec)); }
    session = source_profiles(fs_r, fs_w, sys, env, ffi, rec, session, plan);
    if plan.has_c_flag {
        if str_trim(plan.one_shot_cmd) == "" { return Ok(0); }
        let res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi,
            plan.one_shot_cmd, rec, session);
        return Ok(res.exit_code);
    }
    let job: ScriptJob = ScriptJob {
        path: plan.script_file, args: plan.script_args, rec: rec, session: session
    };
    let mut fin_rc: Int = 0;
    if plan.script_file != "" {
        fin_rc = run_script_file(fs_r, fs_w, sys, env, ffi, job);
    } else {
        fin_rc = run_engine(fs_r, sys, env, time, bind, fs_w, ffi, session);
    }
    return Ok(fin_rc);
}
