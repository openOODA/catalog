// # oosh Argv Check
//
// Logline: Reject unknown flags and answer help or version before a session exists.
//
// Setup: Pure argv walk. Prints help or version, then returns a sentinel string.
//
// Beats:
//   1. --help and --version stop before any other flag is applied.
//   2. A clustered short flag is legal only for c, l, i, s, v, and h.
//   3. -c and --varlink-call each require the following token.

import "version.oo";

fn oosh_help() -> String {
    return "oosh - openOODA bounded shell\n"
        + "usage: oosh [flags] [script.oosh] [args...] [-c <command>]\n\n"
        + "flags:\n"
        + "  -c <command>           execute specified command and exit\n"
        + "  -h, --help             display this help message\n"
        + "  -v, --version          display oosh version\n"
        + "  -l, --login            launch as a login shell\n"
        + "  -i                     force interactive shell mode\n"
        + "  -s                     read commands from standard input\n"
        + "      --norc             do not source ~/.ooshrc startup file\n"
        + "      --noprofile        do not source profile files\n"
        + "      --no-banner        suppress startup banner\n"
        + "      --daemon           launch headless Varlink IPC control daemon\n"
        + "      --varlink          launch headless Varlink IPC control daemon\n"
        + "      --varlink-daemon   launch headless Varlink IPC control daemon\n"
        + "      --varlink-call <s> execute single-shot Varlink IPC JSON call";
}

pub fn validate_argv(args: List[String]) -> Result[String, String] {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == "--help" || a == "-h" {
            println(oosh_help());
            return Ok("showed-help");
        }
        if a == "--version" || a == "-v" {
            println("oosh " + oosh_version());
            return Ok("showed-version");
        }
        if a == "--" { return Ok("validated"); }
        if a == "--help" || a == "--version" || a == "--no-banner"
            || a == "--daemon" || a == "--varlink" || a == "--varlink-daemon"
            || a == "--login" || a == "--norc" || a == "--noprofile" {
            i = i + 1;
        } else if a == "--varlink-call" {
            if i + 1 >= n {
                println("ERR\toosh\t--varlink-call requires a JSON string");
                return Err("missing --varlink-call arg");
            }
            i = i + 2;
        } else if str_starts_with(a, "--") {
            println("ERR\toosh\tunknown flag: " + a);
            return Err("unknown flag");
        } else if str_starts_with(a, "-") && chars_len(a) > 1 {
            let clen: Int = chars_len(a);
            let mut ci: Int = 1;
            let mut has_c: Bool = false;
            let mut valid: Bool = true;
            while ci < clen {
                let ch: String = char_at(a, ci);
                if ch == "c" && ci != clen - 1 { valid = false; }
                if ch == "c" && ci == clen - 1 { has_c = true; }
                let known: Bool = ch == "c" || ch == "l" || ch == "i";
                if !known && ch != "s" && ch != "v" && ch != "h" { valid = false; }
                ci = ci + 1;
            }
            if !valid {
                println("ERR\toosh\tunknown flag: " + a);
                return Err("unknown flag");
            }
            if has_c {
                if i + 1 >= n {
                    println("ERR\toosh\t" + a + " requires a command string");
                    return Err("missing -c arg");
                }
                i = i + 2;
            } else {
                i = i + 1;
            }
        } else {
            return Ok("validated");
        }
    }
    return Ok("validated");
}
