// # oopm Catalog Descriptor (L0-core)
//
// Logline: Canonical signed registry descriptor for oopm in L0-core.
// Setup: Emitted and re-derived by core/cat_index.oo; pure constant surface, zero caps.
// Beats:
//   1. cat_name/cat_layer/cat_version return the registered identity triple.
//   2. cat_caps/cat_deps return the granted capability and dependency sets.
//   3. cat_record joins the fields for cross-checks against the index row.

pub fn cat_name() -> String {
    return "oopm";
}

pub fn cat_layer() -> String {
    return "L0-core";
}

pub fn cat_version() -> String {
    return "2.11.33";
}

pub fn cat_caps() -> String {
    return "FsRead,Env,FsWrite,Process,Net";
}

pub fn cat_deps() -> String {
    return "";
}

pub fn cat_record() -> String {
    let mut r: String = cat_name() + "|" + cat_layer();
    r = r + "|" + cat_version() + "|" + cat_caps();
    r = r + "|" + cat_deps();
    return r;
}
