// # ooda package
//
// Logline: Canonical catalog package anchor for ooda (layers/L0-core).
//
// Setup: Folder shape is manifest plus payload (ooda.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of ooda.oo.
//   2. ooda.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with ooda.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_ooda_pkg() -> String {
    return "ooda";
}
