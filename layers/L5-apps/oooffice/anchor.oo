// # oooffice package
//
// Logline: Canonical catalog package anchor for oooffice (layers/L5-apps).
//
// Setup: Folder shape is manifest plus payload (oooffice.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oooffice.oo.
//   2. oooffice.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oooffice.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oooffice_pkg() -> String {
    return "oooffice";
}
