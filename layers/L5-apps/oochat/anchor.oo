// # oochat package
//
// Logline: Canonical catalog package anchor for oochat (layers/L5-apps).
//
// Setup: Folder shape is manifest plus payload (oochat.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oochat.oo.
//   2. oochat.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oochat.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oochat_pkg() -> String {
    return "oochat";
}
