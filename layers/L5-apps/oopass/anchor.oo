// # oopass package
//
// Logline: Canonical catalog package anchor for oopass (layers/L5-apps).
//
// Setup: Folder shape is manifest plus payload (oopass.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oopass.oo.
//   2. oopass.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oopass.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oopass_pkg() -> String {
    return "oopass";
}
