// # oovoxel package
//
// Logline: Canonical catalog package anchor for oovoxel (layers/L5-apps).
//
// Setup: Folder shape is manifest plus payload (oovoxel.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oovoxel.oo.
//   2. oovoxel.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oovoxel.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oovoxel_pkg() -> String {
    return "oovoxel";
}
