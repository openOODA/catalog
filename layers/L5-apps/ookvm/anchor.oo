// # ookvm package
//
// Logline: Canonical catalog package anchor for ookvm (layers/L5-apps).
//
// Setup: Folder shape is manifest plus payload (ookvm.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of ookvm.oo.
//   2. ookvm.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with ookvm.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_ookvm_pkg() -> String {
    return "ookvm";
}
