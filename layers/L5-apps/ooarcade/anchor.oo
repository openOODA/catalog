// # ooarcade package
//
// Logline: Canonical catalog package anchor for ooarcade (layers/L5-apps).
//
// Setup: Folder shape is manifest plus payload (ooarcade.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of ooarcade.oo.
//   2. ooarcade.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with ooarcade.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_ooarcade_pkg() -> String {
    return "ooarcade";
}
