// # ooflash package
//
// Logline: Canonical catalog package anchor for ooflash (layers/L5-apps).
//
// Setup: Folder shape is manifest plus payload (ooflash.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of ooflash.oo.
//   2. ooflash.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with ooflash.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_ooflash_pkg() -> String {
    return "ooflash";
}
