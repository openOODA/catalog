// # oollama package
//
// Logline: Canonical catalog package anchor for oollama (layers/L2-OS).
//
// Setup: Folder shape is manifest plus payload (oollama.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oollama.oo.
//   2. oollama.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oollama.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oollama_pkg() -> String {
    return "oollama";
}
