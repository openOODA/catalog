// # oonetd package
//
// Logline: Canonical catalog package anchor for oonetd (layers/L2-OS).
//
// Setup: Folder shape is manifest plus payload (oonetd.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oonetd.oo.
//   2. oonetd.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oonetd.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oonetd_pkg() -> String {
    return "oonetd";
}
