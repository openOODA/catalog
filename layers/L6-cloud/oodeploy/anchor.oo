// # oodeploy package
//
// Logline: Canonical catalog package anchor for oodeploy (layers/L6-cloud).
//
// Setup: Folder shape is manifest plus payload (oodeploy.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oodeploy.oo.
//   2. oodeploy.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oodeploy.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oodeploy_pkg() -> String {
    return "oodeploy";
}
