// # oodb package
//
// Logline: Canonical catalog package anchor for oodb (layers/L6-cloud).
//
// Setup: Folder shape is manifest plus payload (oodb.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oodb.oo.
//   2. oodb.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oodb.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oodb_pkg() -> String {
    return "oodb";
}
