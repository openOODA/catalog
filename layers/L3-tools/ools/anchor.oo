// # ools package
//
// Logline: Canonical catalog package anchor for ools (layers/L3-tools).
//
// Setup: Folder shape is manifest plus payload (ools.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of ools.oo.
//   2. ools.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with ools.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_ools_pkg() -> String {
    return "ools";
}
