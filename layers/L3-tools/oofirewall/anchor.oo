// # oofirewall package
//
// Logline: Canonical catalog package anchor for oofirewall (layers/L3-tools).
//
// Setup: Folder shape is manifest plus payload (oofirewall.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oofirewall.oo.
//   2. oofirewall.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oofirewall.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oofirewall_pkg() -> String {
    return "oofirewall";
}
