// # oohw package
//
// Logline: Canonical catalog package anchor for oohw (layers/L3-tools).
//
// Setup: Folder shape is manifest plus payload (oohw.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oohw.oo.
//   2. oohw.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oohw.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oohw_pkg() -> String {
    return "oohw";
}
