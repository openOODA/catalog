// # oocurl package
//
// Logline: Canonical catalog package anchor for oocurl (layers/L3-tools).
//
// Setup: Folder shape is manifest plus payload (oocurl.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oocurl.oo.
//   2. oocurl.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oocurl.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oocurl_pkg() -> String {
    return "oocurl";
}
