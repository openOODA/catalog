// # ooui package
//
// Logline: Canonical catalog package anchor for ooui (layers/L3-tools).
//
// Setup: Folder shape is manifest plus payload (ooui.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of ooui.oo.
//   2. ooui.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with ooui.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_ooui_pkg() -> String {
    return "ooui";
}
