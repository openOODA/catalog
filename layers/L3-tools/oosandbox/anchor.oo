// # oosandbox package
//
// Logline: Canonical catalog package anchor for oosandbox (layers/L3-tools).
//
// Setup: Folder shape is manifest plus payload (oosandbox.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oosandbox.oo.
//   2. oosandbox.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oosandbox.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oosandbox_pkg() -> String {
    return "oosandbox";
}
