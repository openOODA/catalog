// # oofs package
//
// Logline: Canonical catalog package anchor for oofs (layers/L3-tools).
//
// Setup: Folder shape is manifest plus payload (oofs.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oofs.oo.
//   2. oofs.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oofs.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oofs_pkg() -> String {
    return "oofs";
}
