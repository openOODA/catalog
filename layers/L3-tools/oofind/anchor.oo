// # oofind package
//
// Logline: Canonical catalog package anchor for oofind (layers/L3-tools).
//
// Setup: Folder shape is manifest plus payload (oofind.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oofind.oo.
//   2. oofind.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oofind.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oofind_pkg() -> String {
    return "oofind";
}
