// # oojq package
//
// Logline: Canonical catalog package anchor for oojq (layers/L3-tools).
//
// Setup: Folder shape is manifest plus payload (oojq.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oojq.oo.
//   2. oojq.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oojq.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oojq_pkg() -> String {
    return "oojq";
}
