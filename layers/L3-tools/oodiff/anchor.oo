// # oodiff package
//
// Logline: Canonical catalog package anchor for oodiff (layers/L3-tools).
//
// Setup: Folder shape is manifest plus payload (oodiff.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oodiff.oo.
//   2. oodiff.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oodiff.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oodiff_pkg() -> String {
    return "oodiff";
}
