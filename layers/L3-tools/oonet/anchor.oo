// # oonet package
//
// Logline: Canonical catalog package anchor for oonet (layers/L3-tools).
//
// Setup: Folder shape is manifest plus payload (oonet.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oonet.oo.
//   2. oonet.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oonet.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oonet_pkg() -> String {
    return "oonet";
}
