// # oopower package
//
// Logline: Canonical catalog package anchor for oopower (layers/L3-tools).
//
// Setup: Folder shape is manifest plus payload (oopower.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oopower.oo.
//   2. oopower.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oopower.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oopower_pkg() -> String {
    return "oopower";
}
