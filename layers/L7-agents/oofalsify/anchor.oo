// # oofalsify package
//
// Logline: Canonical catalog package anchor for oofalsify (layers/L7-agents).
//
// Setup: Folder shape is manifest plus payload (oofalsify.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oofalsify.oo.
//   2. oofalsify.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with oofalsify.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_oofalsify_pkg() -> String {
    return "oofalsify";
}
