// # ooquota package
//
// Logline: Canonical catalog package anchor for ooquota (layers/L7-agents).
//
// Setup: Folder shape is manifest plus payload (ooquota.oo).
//
// Beats:
//   1. manifest — name, version, caps, sha256 of ooquota.oo.
//   2. ooquota.oo — capability-explicit package payload.
//   3. Keep manifest sha256 in lockstep with ooquota.oo.
//   4. Verified by qa/catalog_proof.oo and qa/suite.oo.

pub fn cat_ooquota_pkg() -> String {
    return "ooquota";
}
