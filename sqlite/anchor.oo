// # Sqlite package
//
// Logline: Boundary SQLite adapter demo for the openOODA catalog. Safe to launch.
//
// Setup: Folder shape is manifest plus payload. Do not import sqlite.oo from this file. sqlite.oo has a main entrypoint and is the payload, not an index. Pure demo. Not a database. Full adapter lands here later.
//
// Beats:
//   1. manifest — name, version, caps, sha256 of sqlite.oo.
//   2. sqlite.oo — payload. Academy headers required.
//   3. Rebuild the parent catalog with: opm bot . then re-sign the index
//      with qa/sign_index.oo (bot rewrites index, invalidating index.sig).

//   4. Keep the manifest sha256 in lockstep with the payload.
//   5. The package page stays inside the catalog file law.

pub fn cat_sqlite_pkg() -> String {
    return "sqlite";
}
