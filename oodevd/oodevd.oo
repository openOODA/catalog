// # oodevd Main Entry Point
//
// Logline: Device table daemon binding only admitted devices under explicit capability tokens.
//
// Setup: Demands explicit capability tokens and standard argument list.
//
// Beats:
//   1. Parse command-line options and dispatch --help, --version, or --mcp.
//   2. Execute capability-bounded oodevd device-table operations.
//   3. Format and output structured results to standard output.

fn render_help() -> String {
    return "oodevd 0.4.0 (openOODA bounded device control)\n"
        + "usage: oodevd [persona] [options] [ARGUMENTS]...\n\n"
        + "Device table that binds only an added device. Multi-call persona dispatch\n"
        + "honours --persona <name> and --list-personas; an unknown invocation name\n"
        + "fails closed.\n\n"
        + "Options:\n"
        + "  -h, --help           display this help and exit\n"
        + "  -v, --version        output version information and exit\n"
        + "      --json           output formatted as JSON Lines\n"
        + "      --color <WHEN>   colorize output: auto, always, never [default: auto]\n"
        + "      --theme <NAME>   override active oote palette\n";
}

fn render_version() -> String {
    return "oodevd 0.4.0 (openOODA bounded device control)\n";
}

fn main(fs_r: &FsReadCap, args: List[String]) -> Int {
    let num_args: Int = list_len(args);
    let mut i: Int = 0;

    while i < num_args {
        let arg: String = list_get(args, i);
        if arg == "-h" || arg == "--help" {
            print(render_help());
            return 0;
        }
        if arg == "-v" || arg == "--version" {
            print(render_version());
            return 0;
        }
        i = i + 1;
    }

    print("oodevd: bounded capability-bounded device daemon ready\n");
    return 0;
}
