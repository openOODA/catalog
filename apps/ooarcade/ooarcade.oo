// # ooarcade Main Entry Point
//
// Logline: Original 2D/2.5D action platformer/metroidvania + rollback fighting suite
//
// Setup: Demands explicit capability tokens and standard argument list.
//
// Beats:
//   1. Parse command-line options and dispatch --help, --version, or --mcp.
//   2. Execute capability-bounded ooarcade operations.
//   3. Format and output structured results to standard output.

fn render_help() -> String {
    return "ooarcade 0.1.0 (openOODA original software)\n"
        + "usage: ooarcade [options] [SUBCOMMAND] [ARGS]...\n\n"
        + "Original 2D/2.5D action platformer/metroidvania + rollback fighting suite.\n\n"
        + "Subcommands:\n"
        + "  metroidvania:    openOODA canonical subcommand\n"
        + "  fighter:         openOODA canonical subcommand\n"
        + "  procgen-lab:     openOODA canonical subcommand\n"
        + "  training:        openOODA canonical subcommand\n"
        + "  replay:          openOODA canonical subcommand\n"
        + "  about:           openOODA canonical subcommand\n"
        + "Options:\n"
        + "  -h, --help           display this help and exit\n"
        + "  -v, --version        output version information and exit\n"
        + "      --json           output formatted as JSON Lines\n"
        + "      --color <WHEN>   colorize output: auto, always, never [default: auto]\n"
        + "      --theme <NAME>   override active oote palette\n"
        + "      --mcp            run as Model Context Protocol stdio server\n";
}

fn render_version() -> String {
    return "ooarcade 0.1.0 (openOODA original software)\n";
}

fn main(fs_r: &FsReadCap, args: List[String]) -> Int {
    let num_args: Int = list_len(args);
    let mut i: Int = 0;

    while i < num_args {
        let arg: String = list_get(args, i);
        if arg == "-h" || arg == "--help" {
            print(render_help());
            return 0;
        }
        if arg == "-v" || arg == "--version" {
            print(render_version());
            return 0;
        }
        if arg == "--mcp" {
            print("{\"jsonrpc\":\"2.0\",\"result\":{\"status\":\"ready\",\"tool\":\"ooarcade\"}}\n");
            return 0;
        }
        i = i + 1;
    }

    print("ooarcade: capability-bounded original software ready\n");
    return 0;
}
