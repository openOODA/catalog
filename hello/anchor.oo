// # Hello package
//
// Logline: Stock catalog package that prints hello. Safe to launch.
//
// Setup: Folder shape is manifest plus payload. Do not import hello.oo from this file. hello.oo has a main entrypoint and is the payload, not an index.
//
// Beats:
//   1. manifest — name, version, caps, sha256 of hello.oo.
//   2. hello.oo — payload. Academy headers required.
//   3. Rebuild the parent catalog with: opm bot .

//   4. Keep the manifest sha256 in lockstep with the payload.
//   5. The package page stays inside the catalog file law.

pub fn cat_hello_pkg() -> String {
    return "hello";
}
