// # Catalog package checker
//
// Logline: Verify one catalog package entry against its manifest and on-disk payload digest.
//
// Setup: Reads catalog text, manifests, and payload files under FsReadCap. No network.
//
// Beats:
//   1. Locate the package line in the catalog and validate its fields.
//   2. Confirm manifest name, payload name, and checksum agreement.
//   3. Recompute the payload digest and compare it to the catalog checksum.

import "qa/digest.oo";

pub fn slurp(fs: &FsReadCap, path: String) -> String {
    if !path_exists(fs, path) { return ""; }
    let rr: Result[String, String] = read_file(fs, path);
    return match rr { Ok(s) => s, Err(_) => "" };
}

fn field(line: String, n: Int) -> String {
    let len: Int = chars_len(line);
    let mut k: Int = 0;
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= len {
        if i == len || char_at(line, i) == "|" {
            if k == n { return str_slice(line, start, i); }
            k = k + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn check_line(line: String) -> String {
    let nm: String = field(line, 0);
    let ver: String = field(line, 1);
    let sha: String = field(line, 4);
    if nm == "" { return "empty name"; }
    if ver == "" { return "empty version " + nm; }
    if !is_valid_checksum(sha) { return "bad sha " + nm; }
    return "";
}

fn find_line(cat: String, name: String) -> String {
    let n: Int = chars_len(cat);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(cat, i) == "\n" {
            if i > start {
                let line: String = str_slice(cat, start, i);
                if field(line, 0) == name { return line; }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

pub fn check_pkg(fs: &FsReadCap, cat: String, name: String, pay: String) -> String {
    let line: String = find_line(cat, name);
    if line == "" { return "missing " + name; }
    let bad: String = check_line(line);
    if bad != "" { return bad; }
    if !path_exists(fs, name + "/manifest") { return "missing manifest " + name; }
    if !path_exists(fs, name + "/" + pay) { return "missing payload " + name; }
    let man: String = slurp(fs, name + "/manifest");
    if kv(man, "name") != name { return "manifest name " + name; }
    let cat_chk: String = field(line, 4);
    let man_chk: String = get_manifest_checksum(man);
    if man_chk == "" || !checksums_match(cat_chk, man_chk) { return "sha drift " + name; }
    if kv(man, "payload") != pay { return "payload name " + name; }
    let pay_content: String = slurp(fs, name + "/" + pay);
    let algo: String = parse_checksum_algo(cat_chk);
    let exp_hex: String = parse_checksum_hex(cat_chk);
    let comp_hex: String = compute_payload_digest(algo, pay_content);
    if comp_hex == "" || comp_hex != exp_hex { return "payload digest mismatch " + name; }
    return "";
}
