// # Catalog checksum digest helpers
//
// Logline: Parse, validate, and compute package checksum digests for catalog verification.
//
// Setup: Reads manifest text and payload content in memory. No filesystem or network.
//
// Beats:
//   1. Extract key/value pairs and checksum algorithms from raw text.
//   2. Validate checksum shape for sha256, blake3, sha3, and sha512 encodings.
//   3. Compute payload digests and compare catalog, manifest, and payload checksums.

import "std/sec/hash/blake3.oo";
import "qa/str_ascii.oo";

pub fn kv(text: String, key: String) -> String {
    let needle: String = key + "=";
    let n: Int = chars_len(text);
    let kn: Int = chars_len(needle);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(text, i) == "\n" {
            if i > start {
                let line: String = str_slice(text, start, i);
                if chars_len(line) >= kn && str_slice(line, 0, kn) == needle {
                    return str_slice(line, kn, chars_len(line));
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

pub fn is_hex_chars(s: String, expected_len: Int) -> Bool {
    if chars_len(s) != expected_len { return false; }
    let mut i: Int = 0;
    while i < expected_len {
        let c: String = char_at(s, i);
        if str_index_of("0123456789abcdef", c) < 0 { return false; }
        i = i + 1;
    }
    return true;
}

pub fn parse_checksum_algo(raw: String) -> String {
    let colon: Int = str_index_of(raw, ":");
    if colon < 0 {
        if is_hex_chars(raw, 64) { return "sha256"; }
        return "";
    }
    let pfx: String = str_slice(raw, 0, colon);
    return ascii_lower(pfx);
}

pub fn parse_checksum_hex(raw: String) -> String {
    let colon: Int = str_index_of(raw, ":");
    if colon < 0 { return raw; }
    return str_slice(raw, colon + 1, chars_len(raw));
}

pub fn is_valid_checksum(raw: String) -> Bool {
    let colon: Int = str_index_of(raw, ":");
    if colon < 0 { return is_hex_chars(raw, 64); }
    let algo: String = parse_checksum_algo(raw);
    let hex: String = parse_checksum_hex(raw);
    if algo == "sha256" || algo == "blake3" || algo == "sha3" {
        return is_hex_chars(hex, 64);
    }
    if algo == "sha512" { return is_hex_chars(hex, 128); }
    return false;
}

pub fn compute_payload_digest(algo: String, text: String) -> String {
    if algo == "sha256" {
        let h: String = crypto_sha256_internal(text);
        if chars_len(h) == 64 { return h; }
    } else if algo == "blake3" {
        let h: String = blake3(text);
        if chars_len(h) == 64 { return h; }
    } else if algo == "sha3" {
        let h: String = crypto_sha3_256_internal(text);
        if chars_len(h) == 64 { return h; }
    } else if algo == "sha512" {
        let h: String = crypto_sha512_internal(text);
        if chars_len(h) == 128 { return h; }
    }
    return "";
}

pub fn get_manifest_checksum(man: String) -> String {
    let c: String = kv(man, "checksum");
    if c != "" { return c; }
    let s256: String = kv(man, "sha256");
    if s256 != "" { return s256; }
    let b3: String = kv(man, "blake3");
    if b3 != "" {
        if str_index_of(b3, ":") >= 0 { return b3; }
        return "blake3:" + b3;
    }
    let s3: String = kv(man, "sha3");
    if s3 != "" {
        if str_index_of(s3, ":") >= 0 { return s3; }
        return "sha3:" + s3;
    }
    let s512: String = kv(man, "sha512");
    if s512 != "" {
        if str_index_of(s512, ":") >= 0 { return s512; }
        return "sha512:" + s512;
    }
    return "";
}

pub fn checksums_match(a: String, b: String) -> Bool {
    let algo_a: String = parse_checksum_algo(a);
    let algo_b: String = parse_checksum_algo(b);
    if algo_a != algo_b || algo_a == "" { return false; }
    return parse_checksum_hex(a) == parse_checksum_hex(b);
}
