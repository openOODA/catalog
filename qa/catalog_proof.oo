// # Catalog index proof
//
// Logline: Verify package catalog with agile manifest checksums and payload authenticity.
//
// Setup: Reads catalog, index, CNAME, manifests, and payload files. No HTTP.
//
// Beats:
//   1. Catalog equals index, non-empty, with valid CNAME and signatures.
//   2. Checksum validation supports bare 64-hex, sha256, blake3, sha3, and sha512.
//   3. Packages match manifest checksums and authentic on-disk payload digests.
//   4. index.sig HMAC-verifies the index body (the `opm add` gate).

import "qa/digest.oo";
import "qa/check_pkg.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
}

fn verify_agile_proofs() -> String {
    let bare: String = "0e31868267f9f1baa1028cdeddade94266420d50a29ade6bb583090618bd97e2";
    if !is_valid_checksum(bare) { return "bare sha256 invalid"; }
    if !is_valid_checksum("sha256:" + bare) { return "prefixed sha256 invalid"; }
    if !is_valid_checksum("blake3:" + bare) { return "blake3 invalid"; }
    if !is_valid_checksum("sha3:" + bare) { return "sha3 invalid"; }
    let dummy512: String = "ddaf35a193617abacc417349ae204131"
        + "12e6fa4e89a97ea20a9eeee64b55d39a2192992a"
        + "274fc1a836ba3c23a3feebbd454d4423643ce80e"
        + "2a9ac94fa54ca49f";
    if !is_valid_checksum("sha512:" + dummy512) { return "sha512 invalid"; }
    if is_valid_checksum("md5:0123456789abcdef") { return "invalid algo accepted"; }
    if is_valid_checksum("sha256:short") { return "short hex accepted"; }
    let bad_hex: String = "sha256:0e31868267f9f1baa1028cdeddade9"
        + "4266420d50a29ade6bb583090618bd97eG";
    if is_valid_checksum(bad_hex) { return "non-hex accepted"; }
    let h256: String = compute_payload_digest("sha256", "abc");
    if h256 != "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" { return "h256 mismatch"; }
    let hb3: String = compute_payload_digest("blake3", "abc");
    if hb3 != "6437b3ac38465133ffb63b75273a8db548c558465d79db03fd359c6cd5bd9d85" { return "blake3 mismatch"; }
    let hs3: String = compute_payload_digest("sha3", "abc");
    if hs3 != "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532" { return "sha3 mismatch"; }
    let hs512: String = compute_payload_digest("sha512", "abc");
    if hs512 != dummy512 { return "sha512 mismatch"; }
    let man_test: String = "name=foo\nchecksum=blake3:6437b3ac38465133ffb63b75273a8db548c558465d79db03fd359c6cd5bd9d85\n";
    let want: String = "blake3:6437b3ac38465133ffb63b75273a8db5"
        + "48c558465d79db03fd359c6cd5bd9d85";
    if get_manifest_checksum(man_test) != want {
        return "manifest checksum failed";
    }
    let tampered_h: String = compute_payload_digest("sha256", "tampered payload");
    if tampered_h == h256 { return "tamper check failed"; }
    return "";
}

// One index name must be a safe slug AND carry the canonical oo*
// prefix — the only admitted exceptions are the three fixture packages
// (caps, echo, hello). Legacy hyphenated ooda-* names never resolve.
fn check_index_name(nm: String) -> String {
    if !pkg_name_safe(nm) { return "refused index name " + nm; }
    if nm == "caps" || nm == "echo" || nm == "hello" { return ""; }
    if str_index_of(nm, "oo") != 0 { return "non-canonical name " + nm; }
    return "";
}

fn check_canonical(cat: String) -> String {
    let lines: List[String] = str_split(cat, "\n");
    let mut seen: Int = 0;
    let mut i: Int = 0;
    while i < list_len(lines) {
        let line: String = list_get(lines, i);
        let bar: Int = str_index_of(line, "|");
        let nm: String = if bar < 0 { line } else { str_slice(line, 0, bar) };
        if nm != "" {
            seen = seen + 1;
            let bad: String = check_index_name(nm);
            if bad != "" { return bad; }
        }
        i = i + 1;
    }
    if seen == 0 { return "empty index sweep"; }
    return "";
}

fn run_proofs(fs: &FsReadCap) -> String {
    let ap: String = verify_agile_proofs();
    if ap != "" { return ap; }
    let cat: String = slurp(fs, "catalog");
    if cat == "" { return "empty catalog"; }
    if cat != slurp(fs, "index") { return "index mismatch"; }
    let cn: String = check_canonical(cat);
    if cn != "" { return cn; }
    if str_index_of(slurp(fs, "CNAME"), "catalog.openooda.org") < 0 { return "CNAME"; }
    if !path_exists(fs, "registry.pub") { return "registry.pub"; }
    if !path_exists(fs, "index.minisig") { return "index.minisig"; }
    let sig: String = slurp(fs, "index.sig");
    if sig == "" { return "index.sig missing"; }
    let expect: String = crypto_hmac_sha256_internal("ooda-local-pm", cat);
    if sig != expect { return "index.sig mismatch"; }
    let h: String = check_pkg(fs, cat, "hello", "hello.oo");
    if h != "" { return h; }
    let e: String = check_pkg(fs, cat, "echo", "echo.oo");
    if e != "" { return e; }
    let c: String = check_pkg(fs, cat, "caps", "caps.oo");
    if c != "" { return c; }
    let s: String = check_pkg(fs, cat, "sqlite", "sqlite.oo");
    if s != "" { return s; }
    return "";
}

pub fn main(fs_r: &FsReadCap) {
    let r1: String = run_proofs(fs_r);
    if r1 != "" { fail(r1); }
    let r2: String = run_proofs(fs_r);
    if r2 != "" { fail(r2); }
    if r1 != r2 { fail("non-deterministic proof runs"); }
    println("catalog_proof: PASSED");
}
