// # openOODA public catalog
//
// Logline: The list of 93 canonical packages oopm search and oopm install can install.
//
// Setup: This repo is a vendor tree. catalog is name|version|caps|deps|sha. Packages live in layers/L0-core through layers/L7-agents; each package folder is manifest + anchor.oo + payload. groups.oot holds the @group install profiles. Host: https://catalog.openooda.org
//
// Beats:
//   1. catalog — the search index. index is a copy. index.sig / index.minisig sign it.
//   2. layers/L0-core..L7-agents — the 8 layer directories holding all 93 canonical package manifests.
//   3. groups.oot — Fedora-style @group profiles (@core, @kernel, @os, @tools, @de, @apps, @games, @cloud, @agents, @all).
//   4. qa/ — catalog_proof.oo, check_pkg.oo, sign_index.oo, suite.oo.
//   5. tests/ — test_catalog.oo (97 assertions).
//   6. docs/ — file format, host, adding a package.

pub fn catalog_anchor_version() -> String {
    return "0.2.5";
}
