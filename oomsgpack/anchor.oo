// # oomsgpack package
//
// Logline: Stock catalog package for oomsgpack.
//
// Setup: Folder shape is manifest plus payload. Do not import oomsgpack.oo from this file.
//
// Beats:
//   1. manifest — name, version, caps, sha256 of oomsgpack.oo.
//   2. oomsgpack.oo — payload. Academy headers required.
//   3. Rebuild the parent catalog with: opm bot .

//   4. Keep the manifest sha256 in lockstep with the payload.
//   5. The package page stays inside the catalog file law.

pub fn cat_oomsgpack_pkg() -> String {
    return "oomsgpack";
}
