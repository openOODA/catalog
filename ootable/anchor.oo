// # ootable package
//
// Logline: Stock catalog package for ootable.
//
// Setup: Folder shape is manifest plus payload. Do not import ootable.oo from this file.
//
// Beats:
//   1. manifest — name, version, caps, sha256 of ootable.oo.
//   2. ootable.oo — payload. Academy headers required.
//   3. Rebuild the parent catalog with: opm bot .

//   4. Keep the manifest sha256 in lockstep with the payload.
//   5. The package page stays inside the catalog file law.

pub fn cat_ootable_pkg() -> String {
    return "ootable";
}
