// # catalog Verification Suite
//
// Logline: Positive and negative-trust assertions over the QA seal and the stock package anchors.
//
// Setup: Pure functions over integers plus the hello package anchor. No IO beyond the read capability.
//
// Beats:
//   1. Assert the hello anchor reports its package name.
//   2. Assert the seal round is deterministic and positive.
//   3. Assert tampered nonces and forged digests fail closed.

import "std/sec/pqc.oo";
import "hello/anchor.oo";

fn expect(cond: Bool, label: String) -> Bool {
    if cond {
        println("ok " + label);
        return true;
    }
    println("FAIL " + label);
    return false;
}

pub fn main(
    fs_r: &FsReadCap,
    args: List[String]
) -> Result[Int, String] {
    let mut p: Int = 0;
    if expect(cat_hello_pkg() == "hello", "01 hello anchor reports its package") { p = p + 1; }
    if expect(oo_pqc_sha3_round(41, 7) == oo_pqc_sha3_round(41, 7), "02 seal round is deterministic") { p = p + 1; }
    if expect(oo_pqc_sha3_round(41, 7) > 0, "03 seal stays in the positive field") { p = p + 1; }
    if expect(oo_pqc_sha3_round(41, 7) != oo_pqc_sha3_round(41, 8), "04 tampered nonce yields a different seal") { p = p + 1; }
    if expect(oo_pqc_sha3_round(0, 7) != oo_pqc_sha3_round(41, 7), "05 forged digest yields a different seal") { p = p + 1; }
    if p == 5 {
        println("catalog tests: 5/5 passed");
        return Ok(0);
    }
    println("catalog tests: FAILED (" + to_string(p) + "/5)");
    return Ok(1);
}
