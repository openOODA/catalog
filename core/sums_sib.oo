// # Catalog Sibling Asset Tracer
//
// Logline: Trace allowed sibling persona assets (<pkg>-build|infer|sched) to a parent package row.
// Setup: Pure string page; zero caps. Enforces the explicit build|infer|sched suffix allowlist
//   so arbitrary multi-hyphen stems cannot piggyback on an indexed package prefix.
// Beats:
//   1. Split the stem on dashes; require at least 3 segments (<ooda>-<word>-<persona>).
//   2. Admit only the explicit persona suffixes build, infer, and sched.
//   3. Reconstruct the parent stem and verify it names an indexed package row.

pub fn cat_sib_traced(hay: String, stem: String) -> Bool {
    let parts: List[String] = str_split(stem, "-");
    let n: Int = list_len(parts);
    if n < 3 { return false; }
    let tail: String = list_get(parts, n - 1);
    if tail != "build" && tail != "infer" && tail != "sched" { return false; }
    let mut parent: String = list_get(parts, 0);
    let mut pi: Int = 1;
    while pi < n - 1 {
        parent = parent + "-" + list_get(parts, pi);
        pi = pi + 1;
    }
    return str_contains(hay, "\n" + parent + "|");
}
