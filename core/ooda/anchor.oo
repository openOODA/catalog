// # ooda package
//
// Logline: Stock catalog package for ooda, the canonical L0 flagship CLI.
//
// Setup: Folder shape is manifest plus payload. Do not import ooda.oo from this file.
//
// Beats:
//   1. manifest — name, version, caps, sha256 of ooda.oo.
//   2. ooda.oo — payload. Academy headers required.
//   3. Rebuild the parent catalog with: opm bot .
//
//   4. Keep the manifest sha256 in lockstep with the payload.
//   5. The package page stays inside the catalog file law.
//

pub fn cat_ooda_pkg() -> String {
    return "ooda";
}
